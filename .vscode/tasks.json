{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "EnglishLearningPlatform.sln"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "run",
      "type": "process",
      "command": "dotnet",
      "args": [
        "watch",
        "--project",
        "src/EnglishLearning.Web",
        "run"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
