@model int

@{
    ViewData["Title"] = $"Lỗi {Model}";
}

<section class="error-page">
    <p class="eyebrow">
        HTTP @Model
    </p>

    @switch (Model)
    {
        case 400:
            <h1>Yêu cầu không hợp lệ</h1>

            <p>
                Dữ liệu được gửi lên không hợp lệ.
                Vui lòng kiểm tra và thử lại.
            </p>
            break;

        case 401:
            <h1>Bạn cần đăng nhập</h1>

            <p>
                Vui lòng đăng nhập để tiếp tục sử dụng
                chức năng này.
            </p>

            <a class="btn"
               asp-controller="Account"
               asp-action="Login">
                Đăng nhập
            </a>
            break;

        case 403:
            <h1>Bạn không có quyền truy cập</h1>

            <p>
                Tài khoản hiện tại không có quyền sử dụng
                chức năng này.
            </p>
            break;

        case 404:
            <h1>Không tìm thấy trang</h1>

            <p>
                Trang bạn đang tìm không tồn tại,
                đã bị xoá hoặc đường dẫn không chính xác.
            </p>
            break;

        default:
            <h1>Không thể xử lý yêu cầu</h1>

            <p>
                Hệ thống không thể hoàn thành yêu cầu.
                Vui lòng thử lại sau.
            </p>
            break;
    }

    <div class="actions">
        <a class="btn"
           asp-controller="Home"
           asp-action="Index">
            Về trang chủ
        </a>

        <button class="btn secondary"
                type="button"
                onclick="history.back()">
            Quay lại
        </button>
    </div>
</section>