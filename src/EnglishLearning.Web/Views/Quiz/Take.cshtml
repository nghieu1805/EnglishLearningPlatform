@model EnglishLearning.Application.DTOs.QuizDto

@{
    ViewData["Title"] = Model.Title;

    bool moveSubmit =
        ViewData["MoveSubmit"] is bool value && value;

    var token = ViewData["AttemptToken"] is Guid attemptToken
        ? attemptToken.ToString()
        : "";
}

<div class="quiz-page">
    <div class="section-heading">
        <div>
            <p class="eyebrow">
                CHECK YOUR KNOWLEDGE
            </p>

            <h1>@Model.Title</h1>

            <p>
                @Model.Questions.Count câu hỏi ·
                Mỗi câu chọn một đáp án.
            </p>
        </div>
    </div>

    <form id="experiment-quiz-form"
          asp-controller="Quiz"
          asp-action="Take"
          asp-route-id="@Model.Id"
          method="post"
          asp-antiforgery="true"
          class="experiment-quiz-form"
          data-attempt-token="@token"
          data-move-submit="@moveSubmit.ToString().ToLowerInvariant()"
          data-metrics-url="@Url.Action("SaveMetrics", "Quiz")">

        @if (!string.IsNullOrEmpty(token))
        {
            <input type="hidden"
                   name="attemptToken"
                   value="@token" />
        }

        <div asp-validation-summary="All"
             class="validation-summary">
        </div>

        <p id="quiz-client-error"
           class="text-danger"
           role="alert"
           hidden>
        </p>

        <div class="experiment-quiz-workspace">
            <div class="experiment-submit-slot experiment-submit-top">
                @if (moveSubmit)
                {
                    <button id="quiz-submit"
                            class="btn"
                            type="submit">
                        Nộp bài và xem kết quả
                    </button>
                }
            </div>

            <div class="experiment-question-panel">
                @for (int questionIndex = 0;
                                questionIndex < Model.Questions.Count;
                                questionIndex++)
                {
                    var question = Model.Questions[questionIndex];

                    <fieldset class="word-card">
                        <legend>
                            Câu @(questionIndex + 1):
                            @question.Prompt
                        </legend>

                        <div class="quiz-choices">
                            @foreach (var choice in question.Choices)
                            {
                                string inputId =
                                $"question-{question.Id}-choice-{choice.Id}";

                                <label class="choice"
                                       for="@inputId">
                                    <input id="@inputId"
                                           type="radio"
                                           name="selections[@question.Id]"
                                           value="@choice.Id"
                                           required />

                                    <span>@choice.Text</span>
                                </label>
                            }
                        </div>
                    </fieldset>
                }
            </div>

            <div class="experiment-submit-slot experiment-submit-bottom">
                @if (!moveSubmit)
                {
                    <button id="quiz-submit"
                            class="btn"
                            type="submit">
                        Nộp bài và xem kết quả
                    </button>
                }
                else
                {
                    @* Vùng vô hình có kích thước bằng nút ở vị trí cũ. *@
                    <span id="old-submit-target"
                          aria-hidden="true"
                          style="display:block; flex:none;">
                    </span>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts
{
    <script src="~/js/experiment-quiz.js"
            asp-append-version="true"
            defer>
    </script>
}