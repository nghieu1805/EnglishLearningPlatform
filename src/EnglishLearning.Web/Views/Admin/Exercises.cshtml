@model List<Exercise>
@{ViewData["Title"]="Quiz";}
<partial name="_AdminNav"/><h1>Quiz</h1><p><a class="btn" asp-action="EditExercise">Thêm mới</a></p>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Chủ đề</th><th>Tên quiz</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Id</td><td>@item.TopicId</td><td>@item.Title</td><td><a asp-action="EditExercise" asp-route-id="@item.Id">Sửa</a> <form method="post" asp-action="DeleteExercise" data-confirm="Xoá bản ghi này và dữ liệu phụ thuộc (nếu có)?"><input type="hidden" name="id" value="@item.Id"/><button class="btn secondary">Xoá</button></form></td></tr>}</tbody></table></div>
@if(Model.Count==0){<p>Chưa có dữ liệu.</p>}
