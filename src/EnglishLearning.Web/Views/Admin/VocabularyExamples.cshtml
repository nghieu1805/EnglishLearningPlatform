@model List<VocabularyExample>
@{ViewData["Title"]="Ví dụ";}
<partial name="_AdminNav"/><h1>Ví dụ</h1><p><a class="btn" asp-action="EditVocabularyExample">Thêm mới</a></p>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Từ vựng</th><th>Câu ví dụ</th><th>Dịch tiếng Việt</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Id</td><td>@item.VocabularyId</td><td>@item.Sentence</td><td>@item.TranslationVi</td><td><a asp-action="EditVocabularyExample" asp-route-id="@item.Id">Sửa</a> <form method="post" asp-action="DeleteVocabularyExample" data-confirm="Xoá bản ghi này và dữ liệu phụ thuộc (nếu có)?"><input type="hidden" name="id" value="@item.Id"/><button class="btn secondary">Xoá</button></form></td></tr>}</tbody></table></div>
@if(Model.Count==0){<p>Chưa có dữ liệu.</p>}
