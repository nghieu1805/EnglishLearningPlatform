@model List<Grade>
@{ViewData["Title"]="Lớp";}
<partial name="_AdminNav"/><h1>Lớp</h1><p><a class="btn" asp-action="EditGrade">Thêm mới</a></p>
<div class="table-wrap"><table><thead><tr><th>ID</th><th>Số lớp (1–12)</th><th>Tên lớp</th><th>Thao tác</th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Id</td><td>@item.Number</td><td>@item.Name</td><td><a asp-action="EditGrade" asp-route-id="@item.Id">Sửa</a> <form method="post" asp-action="DeleteGrade" data-confirm="Xoá bản ghi này và dữ liệu phụ thuộc (nếu có)?"><input type="hidden" name="id" value="@item.Id"/><button class="btn secondary">Xoá</button></form></td></tr>}</tbody></table></div>
@if(Model.Count==0){<p>Chưa có dữ liệu.</p>}
