@{
    ViewData["Title"] = "Quản lý nội dung";
    bool isAdmin = User.IsInRole("Admin");
}

<style>
    .admin-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 40px 24px 70px;
    }

    .admin-title {
        margin-bottom: 8px;
        color: #12372a;
        font-size: 36px;
        font-weight: 700;
    }

    .admin-description {
        margin-bottom: 28px;
        color: #52635c;
    }

    .admin-statistics {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 32px;
    }

    .stat-card {
        padding: 24px;
        border-radius: 12px;
        background: #edf1df;
    }

    .stat-number {
        display: block;
        margin-bottom: 6px;
        color: #12372a;
        font-size: 34px;
        font-weight: 700;
    }

    .stat-label {
        color: #52635c;
    }

    .admin-menu {
        padding: 24px;
        border: 1px solid #d8ded3;
        border-radius: 12px;
        background: #ffffff;
    }

    @@media (max-width: 768px) {
        .admin-statistics {
            grid-template-columns: 1fr;
        }
    }
</style>
<div class="admin-page">
    @if (isAdmin)
    {
        <h1 class="admin-title">Trang quản trị</h1>

        <p class="admin-description">
            Quản lý người dùng, lớp học và toàn bộ nội dung hệ thống.
        </p>
    }
    else
    {
        <h1 class="admin-title">Quản lý nội dung</h1>

        <p class="admin-description">
            Quản lý chủ đề, nguồn SGK, từ vựng và bài quiz.
        </p>
    }

    <div class="admin-statistics">
        @if (isAdmin)
        {
            <div class="stat-card">
                <span class="stat-number">
                    @ViewBag.Users
                </span>

                <span class="stat-label">
                    Người dùng
                </span>
            </div>
        }

        <div class="stat-card">
            <span class="stat-number">
                @ViewBag.Words
            </span>

            <span class="stat-label">
                Từ vựng
            </span>
        </div>

        <div class="stat-card">
            <span class="stat-number">
                @ViewBag.Quizzes
            </span>

            <span class="stat-label">
                Lượt làm quiz
            </span>
        </div>
    </div>
</div>