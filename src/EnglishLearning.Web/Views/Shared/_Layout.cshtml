@using System.Security.Claims
@inject EnglishLearning.Web.Services.ExperimentService ExperimentService

@{
    bool useAdaptedMenu = false;

    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(userId))
        {
            var session = await ExperimentService.GetAsync(userId);
            useAdaptedMenu = session?.AdaptationApplied == true;
        }
    }
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] · ULEARN</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ulearn.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>

<body>
    <!-- Liên kết hỗ trợ truy cập -->
    <a class="skip-link" href="#main">
        Đến nội dung
    </a>

    <!-- HEADER ULEARN -->
    <header class="ulearn-site-header">
        <nav class="shell ulearn-nav"
             aria-label="Điều hướng chính">

            <!-- LOGO ULEARN -->
            <a class="ulearn-brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="ULEARN - Trang chủ">

                <span class="ulearn-brand-icon"
                      aria-hidden="true">🌱</span>

                <span class="ulearn-brand-name">
                    ULEARN
                </span>

                <small>
                    ENGLISH FOR A BRIGHTER TOMORROW
                </small>
            </a>

            <!-- MENU RESPONSIVE -->
            <div class="ulearn-menu">

                <!-- Checkbox điều khiển menu mobile -->
                <input type="checkbox"
                       id="ulearn-menu-toggle"
                       class="ulearn-menu-toggle"
                       aria-label="Mở hoặc đóng menu điều hướng" />

                <!-- Nút mở menu trên điện thoại -->
                <label for="ulearn-menu-toggle"
                       class="ulearn-menu-button">
                    ☰ Menu
                </label>

                <div class="nav-links">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <!-- MENU ĐÃ ĐĂNG NHẬP -->
                        <!-- Giữ nguyên thứ tự menu thích ứng V1 -->
                        @if (useAdaptedMenu)
                        {
                            <a asp-controller="Experiment"
                               asp-action="Index">
                                Phiên trải nghiệm
                            </a>

                            <a asp-controller="Dashboard"
                               asp-action="Index">
                                Tiến độ
                            </a>

                            <a asp-controller="Home"
                               asp-action="Index">
                                Lớp học
                            </a>

                            <a asp-controller="Dictionary"
                               asp-action="Index">
                                Từ điển
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Home"
                               asp-action="Index">
                                Lớp học
                            </a>

                            <a asp-controller="Dictionary"
                               asp-action="Index">
                                Từ điển
                            </a>

                            <a asp-controller="Dashboard"
                               asp-action="Index">
                                Tiến độ
                            </a>

                            <a asp-controller="Experiment"
                               asp-action="Index">
                                Phiên trải nghiệm
                            </a>
                        }

                        <!-- HỒ SƠ -->
                        <a asp-controller="Account"
                           asp-action="Profile">
                            Hồ sơ
                        </a>

                        <!-- QUẢN LÝ NỘI DUNG -->
                        @if (User.IsInRole("Admin") ||
                                            User.IsInRole("Staff"))
                        {
                            <a asp-controller="Admin"
                               asp-action="Index">
                                Quản lý nội dung
                            </a>
                        }

                        <!-- KẾT QUẢ NGHIÊN CỨU -->
                        @if (User.IsInRole("Admin"))
                        {
                            <a asp-controller="ExperimentResults"
                               asp-action="Index">
                                Kết quả trải nghiệm
                            </a>
                        }

                        <!-- ĐĂNG XUẤT -->
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post"
                              asp-antiforgery="true">

                            <button class="btn secondary"
                                    type="submit">
                                Đăng xuất
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- MENU CHƯA ĐĂNG NHẬP -->

                        <a asp-controller="Home"
                           asp-action="Index">
                            Lớp học
                        </a>

                        <a asp-controller="Dictionary"
                           asp-action="Index">
                            Từ điển
                        </a>

                        <!-- ĐĂNG NHẬP -->
                        <a class="ulearn-login"
                           asp-controller="Account"
                           asp-action="Login">
                            Đăng nhập
                        </a>

                        <!-- BẮT ĐẦU HỌC -->
                        <a class="btn ulearn-start"
                           asp-controller="Account"
                           asp-action="Register">
                            Bắt đầu học
                        </a>
                    }

                </div>
            </div>
        </nav>
    </header>

    <!-- NỘI DUNG CHÍNH -->
    <main class="shell" id="main">

        @if (TempData["Message"] is string message)
        {
            <div class="notice" role="status">
                @message
            </div>
        }

        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="shell ulearn-footer">
        <span>
            ULEARN · Học từng từ, tiến bộ mỗi ngày.
        </span>

        <span>
            Grades 1–12
        </span>
    </footer>

    <!-- JAVASCRIPT -->
    <script src="~/js/site.js"
            asp-append-version="true"
            defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
