@model TopicPage

@{
    ViewData["Title"] = Model.Topic.Name;
    ViewData["VocabularyStatuses"] = Model.Statuses;
}

<div class="topic-page">
    <a asp-action="Grade"
       asp-route-id="@Model.Topic.GradeId">
        ← @Model.Topic.Grade?.Name
    </a>

    <p class="eyebrow">LEARNING TOPIC</p>

    <h1>@Model.Topic.Name</h1>

    @if (!string.IsNullOrWhiteSpace(
        Model.Topic.Description))
    {
        <p>@Model.Topic.Description</p>
    }

    @if (Model.Topic.IsDemo)
    {
        <p class="notice">
            Nội dung minh hoạ tự viết; không đại diện
            cho một bộ SGK.
        </p>
    }

    @foreach (var source in Model.Topic.Sources)
    {
        <p class="muted">
            @source.Textbook ·
            @source.Unit ·
            Tên gốc: @source.OriginalTopicName
        </p>
    }

    <div class="actions">
        <a class="btn"
           asp-action="Practice"
           asp-route-id="@Model.Topic.Id">
            Luyện flashcard
        </a>

        @foreach (var exercise in Model.Exercises)
        {
            <a class="btn secondary"
               asp-controller="Quiz"
               asp-action="Take"
               asp-route-id="@exercise.Id">
                @exercise.Title →
            </a>
        }
    </div>

    @if (Model.Topic.Vocabulary.Count == 0)
    {
        <div class="empty">
            Chưa có từ vựng trong chủ đề này.
        </div>
    }
    else
    {
        <section class="vocabulary-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">CORE VOCABULARY</p>
                    <h2>Từ vựng cốt lõi</h2>
                </div>

                <span class="progress-label">
                    @Model.LearnedCount(Model.CoreVocabulary)
                    / @Model.CoreVocabulary.Count đã thuộc
                </span>
            </div>

            @if (Model.CoreVocabulary.Count == 0)
            {
                <div class="empty">
                    Chưa có từ vựng Core.
                </div>
            }
            else
            {
                <div class="cards">
                    @foreach (var vocabulary
                                in Model.CoreVocabulary)
                    {
                        <partial name="_Word"
                                 model="vocabulary" />
                    }
                </div>
            }
        </section>

        <section class="vocabulary-section advanced-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">
                        ADVANCED VOCABULARY
                    </p>

                    <h2>Từ vựng nâng cao</h2>
                </div>

                <span class="progress-label">
                    @Model.LearnedCount(
                    Model.AdvancedVocabulary)
                / @Model.AdvancedVocabulary.Count đã thuộc
            </span>
        </div>

        @if (Model.AdvancedVocabulary.Count == 0)
            {
                <div class="empty">
                    Chưa có từ vựng Advanced
                    trong chủ đề này.
                </div>
            }
            else
            {
                <div class="cards">
                    @foreach (var vocabulary
                                in Model.AdvancedVocabulary)
                    {
                        <partial name="_Word"
                                 model="vocabulary" />
                    }
                </div>
            }
        </section>
    }
</div>